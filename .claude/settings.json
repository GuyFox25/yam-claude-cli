{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/check.mjs:*)",
      "Bash(node --test .claude/hooks/__tests__/*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run type-check:*)",
      "Bash(pnpm -r test:*)",
      "Bash(pnpm -r lint:*)",
      "Bash(pnpm -r typecheck:*)",
      "Bash(pnpm -r run test:*)",
      "Bash(pnpm -r run lint:*)",
      "Bash(pnpm -r run typecheck:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * lint:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * run test:*)",
      "Bash(pnpm --filter * run lint:*)",
      "Bash(pnpm --filter * run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run test --workspace*)",
      "Bash(npm run lint --workspace*)",
      "Bash(npm run typecheck --workspace*)",
      "Bash(npm run test -w *)",
      "Bash(npm run lint -w *)",
      "Bash(npm run typecheck -w *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(node .claude/scripts/lib-info.mjs:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm --filter * add:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(yarn add:*)",
      "Bash(*migrate*)",
      "Bash(*drizzle-kit push*)",
      "Bash(*db:push*)",
      "Bash(*migration:run*)",
      "Bash(*db:seed*)",
      "Bash(*run seed*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet ef:*)",
      "Bash(npm link:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "Bash(mongosh:*)",
      "Bash(mongo:*)",
      "Bash(mongodump:*)",
      "Bash(mongorestore:*)",
      "Bash(*migrate-mongo*)",
      "Bash(*prisma db push*)",
      "Bash(node .claude/scripts/export-template.mjs:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/secrets/**)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.mjs"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-boundaries.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/track-edits.mjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-write.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.mjs",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
